{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voomi public catalog v2",
  "type": "object",
  "required": ["catalogSchemaVersion", "catalogVersion", "updatedAt", "templates"],
  "properties": {
    "catalogSchemaVersion": {"const": "2.0"},
    "catalogVersion": {"type": "integer", "minimum": 0},
    "updatedAt": {"type": "string", "format": "date-time"},
    "templates": {"type": "array", "items": {"type": "object", "required": ["templateId", "templateVersion", "schemaVersion", "name", "description", "categories", "tags", "durationMs", "previewUrl", "downloadUrl", "fileSize", "sha256"], "properties": {"templateId": {"type": "string", "format": "uuid"}, "templateVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"}, "schemaVersion": {"enum": ["2.0", "3.0"]}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "categories": {"type": "array", "items": {"type": "string"}}, "tags": {"type": "array", "items": {"type": "string"}}, "durationMs": {"type": "integer", "minimum": 1}, "previewUrl": {"type": "string", "format": "uri"}, "downloadUrl": {"type": "string", "format": "uri"}, "fileSize": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "requiredFeatures": {"type": "array", "items": {"type": "string"}}, "engine": {"type": "object", "required": ["requiredCapabilities"], "properties": {"requiredCapabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
