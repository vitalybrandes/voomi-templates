{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voomi.example/schemas/template-v2.schema.json",
  "title": "Voomi template metadata v2",
  "description": "Template package metadata using the Voomi Schema v2 layer and timeline contract.",
  "type": "object",
  "required": ["schemaVersion", "templateId", "templateVersion", "name", "description", "durationMs", "canvas", "preview", "mediaSlots", "layers"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "templateId": {"type": "string", "format": "uuid"},
    "templateVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 5000},
    "categories": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "durationMs": {"type": "integer", "minimum": 1, "maximum": 300000},
    "canvas": {
      "type": "object", "required": ["width", "height", "fps"],
      "properties": {"width": {"type": "integer", "minimum": 1, "maximum": 4320}, "height": {"type": "integer", "minimum": 1, "maximum": 4320}, "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}},
      "additionalProperties": false
    },
    "preview": {"const": "preview.jpg"},
    "requiredFeatures": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "mediaSlots": {"type": "array", "items": {"$ref": "#/$defs/mediaSlot"}},
    "textSlots": {"type": "array", "items": {"$ref": "#/$defs/textSlot"}},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer"}}
  },
  "$defs": {
    "mediaSlot": {
      "type": "object", "required": ["id", "type", "label", "required"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "type": {"enum": ["photo", "video", "photo_or_video"]}, "label": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}},
      "additionalProperties": false
    },
    "textSlot": {
      "type": "object", "required": ["id", "label", "defaultValue", "maxLength", "required"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "label": {"type": "string", "minLength": 1}, "defaultValue": {"type": "string"}, "maxLength": {"type": "integer", "minimum": 1, "maximum": 1000}, "required": {"type": "boolean"}},
      "additionalProperties": false
    },
    "stage": {
      "type": "object", "required": ["id", "name", "startMs", "durationMs"],
      "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "name": {"type": "string", "minLength": 1}, "startMs": {"type": "integer", "minimum": 0}, "durationMs": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "layout": {
      "type": "object", "required": ["unit", "x", "y", "width", "height", "rotationDeg", "anchor"],
      "properties": {"unit": {"const": "normalized"}, "x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "rotationDeg": {"type": "number"}, "anchor": {"enum": ["topLeft", "center"]}},
      "additionalProperties": false
    },
    "content": {
      "type": "object", "required": ["fit", "scale", "offsetX", "offsetY"],
      "properties": {"fit": {"enum": ["cover", "contain", "fill"]}, "scale": {"type": "number", "exclusiveMinimum": 0}, "offsetX": {"type": "number"}, "offsetY": {"type": "number"}},
      "additionalProperties": false
    },
    "textStyle": {
      "type": "object", "required": ["fontFamily", "fontSize", "color", "alignment", "verticalAlignment", "maxLines", "autoFit"],
      "properties": {
        "fontFamily": {"type": "string", "minLength": 1}, "fontSource": {"type": "string", "minLength": 1},
        "fontSize": {"type": "number", "exclusiveMinimum": 0}, "color": {"type": "string", "minLength": 1},
        "alignment": {"enum": ["left", "center", "right"]}, "verticalAlignment": {"enum": ["top", "middle", "bottom"]},
        "maxLines": {"type": "integer", "minimum": 1, "maximum": 20}, "autoFit": {"enum": ["shrink", "none"]},
        "stroke": {"type": "object", "required": ["color", "width"], "properties": {"color": {"type": "string", "minLength": 1}, "width": {"type": "number", "minimum": 0}}, "additionalProperties": false},
        "shadow": {"type": "object", "required": ["color", "opacity", "offsetX", "offsetY", "blur"], "properties": {"color": {"type": "string", "minLength": 1}, "opacity": {"type": "number", "minimum": 0, "maximum": 1}, "offsetX": {"type": "number"}, "offsetY": {"type": "number"}, "blur": {"type": "number", "minimum": 0}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "compositing": {
      "oneOf": [
        {"type": "object", "required": ["mode"], "properties": {"mode": {"const": "alpha"}}, "additionalProperties": false},
        {"type": "object", "required": ["mode", "keyColor", "similarity", "smoothness"], "properties": {"mode": {"const": "chromaKey"}, "keyColor": {"type": "string", "minLength": 1}, "similarity": {"type": "number", "minimum": 0, "maximum": 1}, "smoothness": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false}
      ]
    },
    "animation": {
      "type": "object", "required": ["target", "property", "keyframes"],
      "properties": {"target": {"enum": ["layout", "content", "volume"]}, "property": {"type": "string", "minLength": 1}, "keyframes": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["timeMs", "value"], "properties": {"timeMs": {"type": "integer", "minimum": 0}, "value": {"type": "number"}, "easing": {"enum": ["linear", "easeIn", "easeOut", "easeInOut"]}}, "additionalProperties": false}}, "additionalProperties": false}
    },
    "layer": {
      "type": "object", "required": ["id", "type", "startMs", "durationMs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "type": {"enum": ["image", "sticker", "frame", "videoOverlay", "userMedia", "audio", "text"]},
        "source": {"type": "string", "minLength": 1}, "slotId": {"type": "string", "minLength": 1},
        "zIndex": {"type": "integer"}, "startMs": {"type": "integer", "minimum": 0}, "durationMs": {"type": "integer", "minimum": 1}, "sourceStartMs": {"type": "integer", "minimum": 0}, "stageId": {"type": "string"},
        "layout": {"$ref": "#/$defs/layout"}, "content": {"$ref": "#/$defs/content"}, "compositing": {"$ref": "#/$defs/compositing"}, "animations": {"type": "array", "items": {"$ref": "#/$defs/animation"}}, "textStyle": {"$ref": "#/$defs/textStyle"},
        "userAdjustable": {"type": "object", "properties": {"crop": {"type": "boolean"}, "contentScale": {"type": "boolean"}, "contentOffset": {"type": "boolean"}, "layerSize": {"type": "boolean"}, "layerPosition": {"type": "boolean"}, "text": {"type": "boolean"}, "fontSize": {"type": "boolean"}, "color": {"type": "boolean"}}, "additionalProperties": false},
        "volume": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "userMedia"}}, "required": ["type"]}, "then": {"required": ["slotId", "layout", "content"]}},
        {"if": {"properties": {"type": {"const": "audio"}}, "required": ["type"]}, "then": {"required": ["source", "volume"]}},
        {"if": {"properties": {"type": {"const": "text"}}, "required": ["type"]}, "then": {"required": ["slotId", "layout", "textStyle"]}},
        {"if": {"properties": {"type": {"enum": ["image", "sticker", "frame", "videoOverlay"]}}, "required": ["type"]}, "then": {"required": ["source"]}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
